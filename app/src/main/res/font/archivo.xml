<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo (SIL OFL 1.1, see licenses/OFL-Archivo.txt), static instances cut from the variable font. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/archivo_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/archivo_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/archivo_medium" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/archivo_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/archivo_semibold" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/archivo_semibold" app:fontStyle="normal" app:fontWeight="600" />
    <font android:font="@font/archivo_extrabold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/archivo_extrabold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
