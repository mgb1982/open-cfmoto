<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/map_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_trip"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/map_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_share"
            style="@style/Widget.OpenCfMoto.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/share_button" />
    </LinearLayout>

    <!-- "Everything I've ridden": routes / heat, and the period. Hidden for a single trip. -->
    <LinearLayout
        android:id="@+id/map_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_mode_routes"
            style="@style/Widget.OpenCfMoto.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_mode_routes" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_mode_heat"
            style="@style/Widget.OpenCfMoto.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/map_mode_heat" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:background="@color/text_secondary"
            android:alpha="0.3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_period_month"
            style="@style/Widget.OpenCfMoto.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_period_month" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_period_year"
            style="@style/Widget.OpenCfMoto.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_period_year" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_period_all"
            style="@style/Widget.OpenCfMoto.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_period_all" />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
