<?xml version="1.0" encoding="utf-8"?>
<!-- Background: the Garage bike photo (cropped, darkened and framed in code), or the plain card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/brand_orange"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/w_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#E6F1F4EC"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_ride"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="#E6F1F4EC"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
