<?xml version="1.0" encoding="utf-8"?>
<!-- Plain TextViews, not Buttons: the watch's Button style left-aligns its label.
     Round-screen D-pad: a cross around OK, small shortcuts on the diagonals, all inside a 200dp
     square centred on the screen so nothing reaches the curved edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <FrameLayout
    android:id="@+id/pad_box"
    android:layout_width="200dp"
    android:layout_height="200dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/btn_ok"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="@string/btn_ok"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_up"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="15dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="▲"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_down"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="15dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="▼"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_left"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="15dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="◀"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_right"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="15dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="▶"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="28dp"
        android:layout_marginStart="28dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="↩"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="⌂"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_assistant"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="28dp"
        android:layout_marginStart="28dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="🎤"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_trip"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/btn_round"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:padding="0dp"
        android:text="📊"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

  </FrameLayout>

  <!-- Not connected to the bike: the D-pad does nothing, so this page becomes "find my bike". -->
  <LinearLayout
    android:id="@+id/park_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="30dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/park_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/find_title"
        android:textColor="#D1A955"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/park_icon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_compass_arrow" />

    <TextView
        android:id="@+id/park_ago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#F1F4EC"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/park_find"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:text="@string/park_page_find"
        android:textColor="#D1A955"
        android:textSize="14sp"
        android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
