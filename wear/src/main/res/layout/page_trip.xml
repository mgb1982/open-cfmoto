<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingTop="18dp"
    android:paddingEnd="30dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/status_no_phone"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="60sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_speed_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:text="@string/unit_kmh"
        android:textColor="#9E9E9E"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="--"
            android:textColor="#F1F4EC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="--"
            android:textColor="#F1F4EC"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_max_avg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="--"
            android:textColor="#F1F4EC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="--"
            android:textColor="#F1F4EC"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Not riding + a parking spot from the phone: tap = compass to the bike. -->
    <TextView
        android:id="@+id/tv_parked_main"
        android:maxLines="2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="#D1A955"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/hint_logging_off"
        android:textColor="#FFB300"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
